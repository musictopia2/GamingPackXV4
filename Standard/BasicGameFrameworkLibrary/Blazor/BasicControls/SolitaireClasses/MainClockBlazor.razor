@if (DataContext?.ClockList == null)
{
    return;
}

<CascadingValue Value="DataContext">
    <div>
        @if (ChildContent != null)
        {
            <div>
                @ChildContent
            </div>
        }

        <div class="mainclockrelative">
            @foreach (var clock in DataContext.ClockList)
            {
                <div class="mainclockabsolute"
                     style="@GetPositionStyle(clock)">
                    <IndividualClockBlazor SingleClock="clock" />
                </div>
            }
        </div>
    </div>
</CascadingValue>