@typeparam D
<StateContentView DataContext="IndividualPile">
    @if (MainGroup == null || MainGroup.Piles == null || _card == null)
    {
        return;
    }
    @if (MainGroup.Piles.HasFrame)
    {
        <BaseFrameBlazor IsEnabled="@IsEnabled">
            <LegendContent>
                @if (string.IsNullOrWhiteSpace(IndividualPile!.Text) == false)
                {
                    <CompactLabel>
                        @IndividualPile.Text
                    </CompactLabel>
                }
            </LegendContent>
            <ChildContent>
                <FlexibleDeckRenderComponent D="D" DeckObject="_card">
                    @ChildContent!(_card)
                </FlexibleDeckRenderComponent>
            </ChildContent>
        </BaseFrameBlazor>
        return;
    }
    <VisibleHiddenComponent Visible="_card.Visible == false">
        <svg viewBox="@GetViewBox(_card)" style="height: @HeightPixels">
            <rect fill="none" width="100%" height="100%" />
        </svg>
    </VisibleHiddenComponent>
    <VisibleHiddenComponent Visible="_card.Visible">
        <FlexibleDeckRenderComponent D="D" DeckObject="_card">
            @ChildContent!(_card)
        </FlexibleDeckRenderComponent>
    </VisibleHiddenComponent>
</StateContentView>