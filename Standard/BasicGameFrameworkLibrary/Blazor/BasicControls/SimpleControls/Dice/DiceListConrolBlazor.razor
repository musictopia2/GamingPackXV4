@typeparam D
<StateContentView DataContext="Cup">
    @if (Cup == null || Cup.CanShowDice == false || Cup.Visible == false)
    {
        <svg height="@TargetHeight">
        </svg>
        return;
    }

    @foreach (var dice in Cup.DiceList)
    {
        <StateContentView DataContext="dice">
            <StandardDiceBlazor CommandParameter="dice" Dice="dice" CommandObject="Cup.DiceCommand" TargetHeight="@TargetHeight" />
        </StateContentView>

    }
</StateContentView>
