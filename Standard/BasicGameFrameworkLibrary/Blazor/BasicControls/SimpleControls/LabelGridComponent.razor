@if (Width == "" && Height == "")
{
    <table>
        @foreach (var item in Labels)
        {
            <LabelItemComponent DataContext="DataContext"
                Model="item"
                DecimalPlaces="DecimalPlaces"
                />
        }
    </table>
    return;
}
<div class="main" style="width: @Width; height: @Height;">
    <table>
        @foreach (var item in Labels)
        {
            <LabelItemComponent DataContext="DataContext"
                                Model="item"
                                DecimalPlaces="DecimalPlaces" />
        }
    </table>
</div>