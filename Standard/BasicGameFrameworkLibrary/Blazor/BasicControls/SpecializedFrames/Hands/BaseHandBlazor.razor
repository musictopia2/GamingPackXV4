@using BasicGameFrameworkLibrary.Blazor.Views
@inherits KeyComponentBase
@typeparam D
@if (Hand == null)
{
    return;
}
<CascadingValue Value="this">
    <SimpleControlView DataContext="Hand">
        @if (Hand.Visible == false)
        {
            return;
        }
        @if (Hand.HasFrame)
        {
            <fieldset @key="Hand"
                      @onclick="BoardClicked"
                      style="display:inline-block; min-width:0; @GetColorStyle();"
                      disabled="@IsDisabled">
                <legend style="float:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; max-width:100%; @GetLegendStyle()">
                    <CompactLabel SizeCategory="SizeCategory">
                        @Hand.Text
                    </CompactLabel>
                </legend>

                <div style="@GetContainerStyle()">
                    <div style="@GetContentStyle()">
                        @for (int i = 0; i < Hand.HandList.Count; i++)
                        {
                            D card = Hand.HandList[i];
                            <div style="@GetCardStyle(i)">
                                <FlexibleDeckRenderComponent D="D"
                                                             DeckObject="card"
                                                             UseKey="UseKey">
                                    @ChildContent!(card)
                                </FlexibleDeckRenderComponent>
                            </div>
                        }
                    </div>
                </div>
            </fieldset>
        }
        else
        {
            <div @key="Hand" @onclick="BoardClicked" style="@GetContainerStyle() display:inline-block; margin: 0px;">
                @for (int i = 0; i < Hand.HandList.Count; i++)
                {
                    D card = Hand.HandList[i];
                    <div style="@GetCardStyle(i)">
                        <FlexibleDeckRenderComponent D="D" DeckObject="card" UseKey="UseKey">
                            @ChildContent!(card)
                        </FlexibleDeckRenderComponent>
                    </div>
                }
            </div>
        }
    </SimpleControlView>
</CascadingValue>