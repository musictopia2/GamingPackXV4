@if (ListPicker == null)
{
    return;
}

@{
    int rows = TotalRows(ListPicker.TextList.Count);
    int columns = DisplayColumns();
    int index = 0;
}

@for (int r = 0; r < rows; r++)
{
    <div>
        @for (int c = 0; c < columns; c++)
        {
            if (index < ListPicker.TextList.Count)
            {
                var piece = ListPicker.TextList[index];

                <CascadingValue Value="this">
                    <StateContentView DataContext="piece">
                        <BasePieceGraphics IsSelected="@piece.IsSelected"
                                           CommandParameter="@piece"
                                           CommandObject="@ListPicker.ItemSelectedCommand">
                            <ListViewPiece DataContext="piece"
                                           TextColor="@TextColor"
                                           CanHighlight="@CanHighlight" />
                        </BasePieceGraphics>
                    </StateContentView>
                </CascadingValue>

                index++;
            }
        }
    </div>
}