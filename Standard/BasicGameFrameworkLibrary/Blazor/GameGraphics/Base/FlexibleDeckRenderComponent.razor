@typeparam D
@using BasicBlazorLibrary.Components.RenderHelpers
@using BasicGameFrameworkLibrary.Blazor.Views
@if (DeckObject == null)
{
    return; //i think if setting as nothing, go ahead and dispose everything afterall.
}
<StateContentView DataContext="DeckObject">
    @if (UseKey == false)
    {
        @ChildContent
    }
    else
    {
        <RefreshComponent CanRender="@CanRender"
                          Key="DeckObject.GetKey()">
            @ChildContent
        </RefreshComponent>
    }
</StateContentView>