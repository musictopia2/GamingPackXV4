@using aa1 = BasicGameFrameworkLibrary.Blazor.Helpers.LoaderGlobalClass;
@if (BasicData == null || GameData == null)
{
    return;
}
@{
    SetNickNameAsync();
}
@if (_loading)
{
    <p>Loading Game Package</p>
    return;
}
<LandscapeShell>
    <CascadingValue Value="TestData">
        <CascadingValue Value="BasicData">
            <CascadingValue Value="GameData">
                @if (BasicData.NickName == "")
                {
                    <p>Enter Nick Name</p>
                    <div>
                        <input type="text" @bind-value="BasicData.NickName" />
                    </div>
                    <div>
                        <GameActionButton CustomCallBack="ProcessNickNameAsync" Display="Submit" />
                    </div>
                }
                else
                {
                    <div class="game-shell">
                        <div class="top-bar">
                            @if (aa1.BackToMainDelegate is not null)
                            {
                                <TopBarButton CustomCallBack="aa1.BackToMainDelegate" Display="Back To Main" />
                            }
                            @if (TestData!.ShowNickNameOnShell)
                            {
                                <TopBarLabel Display="@BasicData.NickName" />
                            }
                            @if (_fullScreen && ll1.LayoutMode == EnumGameLayoutMode.Compact)
                            {
                                <TopBarLabel Display="@GameData.GameName" MarginLeft="10px" />
                            }
                            else
                            {
                                <TopBarLabel Display="@GameData.GameName" />
                            }
                            <NewGameView />
                            <NewRoundView />
                            <RestoreView />
                            @if (NeedsFullScreen() == true)
                            {
                                <TopBarButton CustomCallBack="ManuallyOpenCloseFullScreenAsync" Display="@GetDisplay" />
                            }
                        </div>
                        <GameContentShell>
                            @ChildContent
                        </GameContentShell>
                    </div>
                }
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</LandscapeShell>