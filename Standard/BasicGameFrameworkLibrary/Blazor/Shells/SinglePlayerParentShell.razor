@using aa1 = BasicGameFrameworkLibrary.Blazor.Helpers.LoaderGlobalClass;
<LandscapeShell>
    <CascadingValue Value="BasicData">
        <CascadingValue Value="GameInfo">
            @if (BasicData.GameDataLoading)
            {
                return;
            }
            <div class="game-shell">
                <div class="top-bar">
                    @if (aa1.BackToMainDelegate is not null)
                    {
                        <TopBarButton CustomCallBack="aa1.BackToMainDelegate" Display="Back To Main" />
                    }
                    <TopBarLabel Display="@GameInfo.GameName" />
                    <NewGameView />
                </div>
                <GameContentShell>
                    @ChildContent
                </GameContentShell>
            </div>
        </CascadingValue>
    </CascadingValue>
</LandscapeShell>