@typeparam E
@typeparam P
@using BasicGameFrameworkLibrary.Blazor.BasicControls.ChoicePickers

@if (_dataContext is null)
{
    return;
}
<StateContentView DataContext="_dataContext">
    @if (_dataContext.Turn == "")
    {
        return;
    }
    <EnumPickerBlazor E="E" Context="Piece" ListPicker="_dataContext.GetColorPicker">
        @ChildContent!(Piece)
    </EnumPickerBlazor>
    <LabelGridComponent DataContext="_dataContext" Labels="_labels" />
</StateContentView>