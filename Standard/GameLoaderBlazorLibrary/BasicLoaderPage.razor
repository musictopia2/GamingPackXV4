@page "/"
@using BasicGameFrameworkLibrary.Blazor.Shells
<GamePackageFullScreen>
    <LandscapeShell>
        @if (_loadedOnce == false)
        {
            //attempt to do nothing.  since this now shows up for a second (freaky)
            return;
        }
        @if (_updateAvailable)
        {
            <div>
                <TopBarButton CustomCallBack="RefreshAsync" Display="Update Available - Click to Refresh" />
            </div>
            return;
        }
        @if (DataContext!.GameList.Count == 0)
        {
            return;
        }
        @if (LayoutInfo.LayoutMode == EnumGameLayoutMode.Compact
            && GetVisibleGames().Count == 0)
        {
            <div>
                @DataContext.Title has no games that support compact devices.
                Please use a larger tablet or desktop.
            </div>
            return;
        }
        @if (_nextGameHost != "")
        {
            <div>Waiting for @_nextGameHost to choose the next game...</div>
            <HostedGameDiscoveryComponent OnCancel="CancelWaiting"
                                          HostName="@_nextGameHost"
                                          OnGameChosen="SelectDiscoveredGameAsync" />
            return;
        }
        @if (DataContext.GameName == "")
        {
            @if (_showSettings)
            {
                <GameSettingsComponent CloseSettings="ClosedSettings" />
                return;
            }
            <div style="position: fixed; inset: 0; display: flex; flex-direction: column; overflow: hidden;">
                <div style="flex: 0 0 auto;">
                    @if (GlobalClass.Multiplayer)
                    {
                        <div style="display: flex; align-items: center;
                            flex-wrap: nowrap; gap: 0.5rem;
                            overflow-x: auto;">

                            <div style="flex: 0 0 auto;">
                                <TopBarButton CustomCallBack="OpenSettings"
                                              Display="Show Settings" />
                            </div>

                            <div style="flex: 0 0 auto;">
                                <TopBarButton CustomCallBack="RefreshAsync"
                                              Display="Refresh Manually" />
                            </div>

                            @if (IsGameSupported(_previousGame))
                            {
                                <div style="flex: 0 0 auto;">
                                    @if (GlobalDataModel.DataContext?.PlayerMode
                                        == EnumPlayerMode.LetHostChoose)
                                    {
                                        <TopBarLabel Display="@_previousGame" />
                                    }
                                    else
                                    {
                                        <TopBarButton CustomCallBack="OpenPreviousGameAsync"
                                                      Display="@_previousGame" />
                                    }
                                </div>
                            }

                            <div style="flex: 0 0 auto;">
                                <TopBarLabel Display="@Version" />
                            </div>

                            @if (GlobalClass.HasServer &&
                                (GlobalDataModel.DataContext?.PlayerMode
                                    == EnumPlayerMode.LetHostChoose ||
                                 GlobalDataModel.DataContext?.PlayerMode
                                    == EnumPlayerMode.AllOptions))
                            {
                                <div style="display: flex; align-items: center; flex: 0 0 auto;">
                                    @if (_showHostDiscovery == false)
                                    {
                                        <TopBarButton CustomCallBack="ShowHostDiscovery"
                                                      Display="Connect To Host" />
                                    }
                                    else
                                    {
                                        <HostedGameDiscoveryComponent OnCancel="CancelWaiting"
                                                                      OnGameChosen="SelectDiscoveredGameAsync" />
                                    }
                                </div>
                            }
                            @if (GlobalClass.HasServer && LayoutInfo.LayoutMode is not EnumGameLayoutMode.Compact &&
                                (GlobalDataModel.DataContext?.PlayerMode
                                    == EnumPlayerMode.Host ||
                                 GlobalDataModel.DataContext?.PlayerMode
                                    == EnumPlayerMode.AllOptions))
                            {
                                <TopBarButton CustomCallBack="ToggleCompactCompatible"
                                              Display="@(_showCompactCompatibleOnly
                                              ? "Show All Games"
                                              : "Show Small-Device Games Only")" />
                            }
                        </div>
                    }
                </div>
                <div>
                    @if (LoaderGlobalClass.ChoosingNextGameAsHost)
                    {
                        <div>
                            Showing games that support your group of
                            @LoaderGlobalClass.NextGameHumanCount human players.
                        </div>
                    }

                    @if (LayoutInfo.LayoutMode == EnumGameLayoutMode.Compact)
                    {
                        <div>
                            Showing games for this device.
                            Larger devices support additional games.
                        </div>
                    }
                    else if (_showCompactCompatibleOnly)
                    {
                        <div>Filter: Small-device compatible games</div>
                    }
                    else if (LoaderGlobalClass.ChoosingNextGameAsHost == false)
                    {
                        <div>Showing all games in this bundle</div>
                    }
                </div>
                <div style="flex: 1 1 0; min-height: 0; min-width: 0; overflow-y: auto;">
                    @if (CanShowGameList())
                    {
                        var visibleGames = GetVisibleGames();
                        @if (visibleGames.Count == 0)
                        {
                            <div>No supported games are available for this device.</div>
                        }
                        else
                        {
                            <WrapLayout ColumnWidth="22vw" Margins="3px" RenderList="visibleGames" Context="game">
                                @if (GlobalClass.Multiplayer
                                    && GlobalDataModel.DataContext?.PlayerMode == EnumPlayerMode.LetHostChoose)
                                {
                                    <div style="font-size: 2rem;">@game</div>
                                }
                                else
                                {
                                    <GameSelectionButton OnClick="() => SelectGameAsync(game)" Display="@game" />
                                }
                            </WrapLayout>
                        }
                    }
                </div>
            </div>
            return;
        }
        @DataContext.GameRendered
    </LandscapeShell>
</GamePackageFullScreen>