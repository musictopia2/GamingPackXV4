@using BasicGameFrameworkLibrary.Core.StandardImplementations.Settings;
@using bb1 = GameLoaderBlazorLibrary.HomeNetworkConfiguration;
@if (GlobalDataModel.DataContext == null)
{
    return;
}
@if (_showPlayerSettings)
{
    <PlayerSettingsMainComponent
        PlayerMode="GlobalDataModel.DataContext.PlayerMode"
        OnCancel="CancelPlayerSettings"
        OnPlayerSelectionChosen="UpdatePlayerOptions" />
    return;
}
<div style="position: fixed; inset: 0; overflow: auto; box-sizing: border-box; padding: 8px; padding-bottom: max(16px, env(safe-area-inset-bottom));">
    <GridContainer ColumnGap="20px"
                   RowGap="10px"
                   Columns="@GetColumns"
                   Rows="@GetRows">

        <GridItem Row="1" Column="1">
            <div class="margins">
                Server Option Chosen
            </div>
        </GridItem>

        <GridItem Row="1" Column="2">
            <div class="margins">
                @GlobalDataModel.DataContext.ServerMode
            </div>
        </GridItem>

        <GridItem Row="2" Column="1">
            <div class="margins">
                Nick Name
            </div>
        </GridItem>

        <GridItem Row="2" Column="2">
            <input @ref="_nickElement"
                   class="margins"
                   autocapitalize="none"
                   @bind="GlobalDataModel.DataContext.NickName"
                   @bind:event="oninput" />
        </GridItem>

        <GridItem Row="3" Column="2">
            <GameActionButton CustomCallBack="() => UpdateServerOptions(EnumServerMode.HostedServer)"
                              Display="Use Hosted Server" />
        </GridItem>

        @if (GlobalDataModel.DataContext.ServerMode == EnumServerMode.HostedServer)
        {
            <GridItem Row="4" Column="1">
                <div class="margins">
                    Custom Server URL
                </div>
            </GridItem>

            <GridItem Row="4" Column="2">
                <input class="margins"
                       @bind="GlobalDataModel.DataContext.CustomHostedServerUrl" />

                <div class="margins">
                    Leave blank to use the default server.
                </div>
            </GridItem>
        }

        @if (bb1.CanUseHome)
        {
            <GridItem Row="5" Column="2">
                <GameActionButton CustomCallBack="() => UpdateServerOptions(EnumServerMode.HomeHosting)"
                                  Display="Use Home Hosting" />

                <div class="margins">
                    This allows hosting on your own network.
                    You are responsible for making sure that server exists.
                </div>
            </GridItem>
        }


        <GridItem Row="6" Column="1">
            Change Player Options
        </GridItem>
        <GridItem Row="6" Column="2">
            <GameActionButton CustomCallBack="ShowPlayerSettings" Display="Change Player Settings" />
        </GridItem>


        @* <GridItem Row="6" Column="2">
            <GameActionButton CustomCallBack="() => UpdatePlayerOptions(EnumPlayerMode.Any)"
                              Display="Use Any Player Option" />
        </GridItem>

        <GridItem Row="7" Column="2">
            <GameActionButton CustomCallBack="() => UpdatePlayerOptions(EnumPlayerMode.HostOnly)"
                              Display="Host Game Only" />
        </GridItem>

        <GridItem Row="8" Column="2">
            <GameActionButton CustomCallBack="() => UpdatePlayerOptions(EnumPlayerMode.JoinOnly)"
                              Display="Join Game Only" />
        </GridItem> *@

        <GridItem Row="7" Column="1">
            Player Mode
        </GridItem>

        <GridItem Row="7" Column="2">
            @GlobalDataModel.DataContext.PlayerMode
        </GridItem>

        <GridItem Row="8" Column="2">
            <GameActionButton CustomCallBack="SaveChangesAsync"
                              Display="Save Changes" />

            @if (_beginaccept)
            {
                <GameActionButton CustomCallBack="CancelAsync"
                                  Display="Cancel" />
            }
        </GridItem>
    </GridContainer>
</div>

@code {
    private ElementReference _nickElement;
}