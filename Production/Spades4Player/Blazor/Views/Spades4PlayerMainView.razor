@inherits CascadingGameView<Spades4PlayerMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout>
    <StackItem>
        <ScoreBoardBlazor P="Spades4PlayerPlayerItem"
                          Columns="_scores"
                          Players="_gameContainer.SaveRoot.PlayerList" />
    </StackItem>
    <StackItem>
        <LabelGridComponent DataContext="_vmData" Labels="_labels" />
    </StackItem>
    <StackItem>
        <StateContentView DataContext="_gameContainer.SaveRoot">
            @if (_gameContainer.SaveRoot.GameStatus == EnumGameStatus.Bidding)
            {
                <BiddingComponent DataContext="DataContext" />
            }
            else
            {
                <DeckOfCardsSeveralPlayersTrickBlazor P="Spades4PlayerPlayerItem"
                                                      B="SpadesTrickAreaCP"
                                                      T="Spades4PlayerCardInformation"
                                                      DataContext="_vmData.TrickArea1" />
            }
        </StateContentView>
        
    </StackItem>
</StackLayout>
<div>
    <DeckOfCardsHandBlazor R="Spades4PlayerCardInformation" 
        AdditionalSpacing="1"
        Hand="_vmData.PlayerHand1" />
</div>