<StateContentView DataContext="Rounds">
    @if (Rounds == null || Rounds.Count == 0)
    {
        return;
    }
    @foreach (var round in Rounds)
    {
        <div style="font-weight: bold; font-size: @RealHeight; margin-right: 5px; margin-bottom: 10px;">
            @round.Description
        </div>
    }
</StateContentView>