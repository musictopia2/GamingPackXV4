<div style="height: @ImageHeight; margin-bottom: 4px;">
    <StackLayout>
        @foreach (var item in DiceList)
        {
            <StackItem>
                <StateContentView DataContext="item">
                    <SorryDiceComponent HeightPercent="@HeightPercent"
                                        CommandObject="DiceCommand"
                                        CommandParameter="item"
                                        Dice="item" />
                </StateContentView>
                
            </StackItem>
        }
    </StackLayout>
</div>