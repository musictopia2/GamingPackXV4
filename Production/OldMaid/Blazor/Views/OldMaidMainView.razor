@inherits CascadingGameView<OldMaidMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout>
    <StackItem>
        <StateContentView DataContext="DataContext">
            @if (DataContext.OpponentScreen is not null)
            {
                <DeckOfCardsHandBlazor Divider="1.4" R="RegularSimpleCard" Hand="_vmData.OpponentCards1" />
            }
        </StateContentView>
    </StackItem>
    <StackItem>
        <DeckOfCardsSingleMiscPileBlazor R="RegularSimpleCard" SinglePile="_vmData.Pile1" />
    </StackItem>
    
    <StackItem>
        <GameActionButton Display="End Turn" CommandObject="EndCommand" />
    </StackItem>
    <StackItem>
        <GameActionButton Display="Remove Pairs Automatically" CommandObject="RemovePairsCommand" />
    </StackItem>
</StackLayout>
<div>
    <DeckOfCardsHandBlazor Divider="1.4" R="RegularSimpleCard" Hand="_vmData.PlayerHand1" />
</div>
<div>
    <LabelGridComponent DataContext="@_vmData" Labels="_labels" />
</div>