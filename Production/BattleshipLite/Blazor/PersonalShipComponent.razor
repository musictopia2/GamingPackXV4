<StateContentView DataContext="DataContext!.GetSelf">
    @{
        var ships = DataContext!.YourPlacedShips();
    }
    <svg height="@TargetHeight" width="100%" viewBox="0 0 200 310">
        @{
            int y = 1;
        }
        @foreach (var ship in ships)
        {
            <PersonalShipPiece OpponentShip="DataContext.OpponentShip(ship)" YourShip="ship" Y="y" />
            y += 62;
        }
    </svg>
</StateContentView>