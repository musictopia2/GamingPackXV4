@inherits CascadingGameView<PassOutDiceGameMainViewModel>
<StackLayout>
    <StackItem>
        <GameBoardBlazor GraphicsData="_graphicsData" TargetHeight="100" />
    </StackItem>
    <StackItem>
        <div style="height: @Pixels">
            <GameActionButton CommandObject="EndCommand" Display="End Turn" />
            <DiceListConrolBlazor D="SimpleDice" Cup="@DataContext!.GetCup" PercentHeight="_height" />
        </div>
        <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
    </StackItem>
</StackLayout>