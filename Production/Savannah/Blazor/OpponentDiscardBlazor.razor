<StateContentView DataContext="Player">
    <BaseFrameBlazor IsEnabled="@IsEnabled!.Invoke()">
        <LegendContent>
            @Player!.NickName
        </LegendContent>
        <ChildContent>
            @{
                RegularSimpleCard? card = LastCard;
                @if (card is null)
                {
                    return;
                }
            }
            @ChildContent!(card)
        </ChildContent>
        
    </BaseFrameBlazor>
</StateContentView>