<StateContentView DataContext="Missions">

    @if (DataContext == null || Missions == null)
    {
        return;
    }
    <BaseFrameBlazor>
        <LegendContent>
            Mission List
        </LegendContent>
        <ChildContent>
            <GridContainer Rows="@GetRowsColumn" Columns="@GetRowsColumn">
                @{
                    int x;
                    int y;
                    x = 1;
                    y = 1;
                }
                @foreach (var mission in Missions)
                {
                    <GridItem Column="x" Row="y">
                        <GameActionButton CommandParameter="mission"
                                          Display="@mission.Description"
                                          CommandObject="SelectCommand"
                                          BackgroundColor="@BackgroundColor(mission)"
                                          StartOnNewLine="false"
                                          SizeCategory="EnumSize.Small"
                                          WidthCategory="EnumWidth.Wide"
                                          UseSuggestedWidth="true" />
                    </GridItem>
                    x++;
                    if (x > 3)
                    {
                        x = 1;
                        y++;
                    }
                }
            </GridContainer>
            <div style="margin-top: 20px">
                <GameActionButton CommandObject="CompleteCommand"
                                  Display="Complete Mission"
                                  SizeCategory="EnumSize.Small"
                                  WidthCategory="EnumWidth.Wide"
                                  UseSuggestedWidth="true"                      />
                <GameActionButton CommandObject="DescriptionCommand"
                                  SizeCategory="EnumSize.Small"
                                  WidthCategory="EnumWidth.Wide"
                                  UseSuggestedWidth="true"
                                  Display="Mission Description" />

            </div>
        </ChildContent>
        
    </BaseFrameBlazor>
</StateContentView>
