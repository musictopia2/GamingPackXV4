@inherits ParameterGameView<AdvancedOptionsViewModel>
@if (DataContext == null)
{
    return;
}
<div style="margin-top:5px;">
    <ListChooserBlazor TotalColumns="2" ListPicker="DataContext.Easy1" TextWidth="110" SizeCategory="EnumSize.Large"/>
</div>
<div style="margin-top: 20px;">
    <ListChooserBlazor TotalColumns="2" ListPicker="DataContext.Game1" TextWidth="110" SizeCategory="EnumSize.Large" />
</div>
<GameActionButton SizeCategory="EnumSize.Large" Display="Submit" CommandObject="DataContext.SubmitCommand" />