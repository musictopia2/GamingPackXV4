@inherits CascadingGameView<RollEmMainViewModel>
<StackLayout ItemSpacing="10px">
    <StackItem>
        <GameBoardBlazor BoardData="_boardData"
                         TargetHeight="95" />
    </StackItem>
    <StackItem>
        <div>
            <GameActionButton SizeCategory="EnumSize.Large" CommandObject="RollCommand" Display="Roll Dice" />
            <GameActionButton SizeCategory="EnumSize.Large" CommandObject="EndCommand" Display="End Turn" />
        </div>
        <div class="@cc1.CenteredFlex" style="height: @Pixels">
            <DiceListConrolBlazor D="SimpleDice" Cup="@DataContext!.GetCup" PercentHeight="_height" />
        </div>
        <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
        <div>
            <ScoreBoardBlazor P="RollEmPlayerItem" Columns="@_scores" Players="@DataContext!.PlayerList" />
        </div>
    </StackItem>
</StackLayout>