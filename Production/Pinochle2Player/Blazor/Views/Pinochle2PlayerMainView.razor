@inherits CascadingGameView<Pinochle2PlayerMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<div class="game-layout">
    <div class="play-area">
        <StackLayout>
            <StackItem>
                <DeckOfCardsSingleMiscPileBlazor R="Pinochle2PlayerCardInformation" SinglePile="_vmData.Pile1" />
                <DeckOfCardsDrawPileBlazor R="Pinochle2PlayerCardInformation" DeckPile="_vmData.Deck1" />
            </StackItem>
            <StackItem>
                <DeckOfCardsTwoPlayerTrickBlazor T="Pinochle2PlayerCardInformation" DataContext="_vmData.TrickArea1" />
            </StackItem>
        </StackLayout>
        <div>
            <DeckOfCardsHandBlazor R="Pinochle2PlayerCardInformation"
                AdditionalSpacing="1"
                Hand="_vmData.PlayerHand1" />
        </div>
        <StackLayout>
            <StackItem>
                <GameActionButton StartOnNewLine="true"
                                     CommandObject="MeldCommand"
                                     Display="Meld" />
                <GameActionButton StartOnNewLine="true"
                                     CommandObject="EndCommand"
                                     Display="End Turn" />
                <ScoreBoardBlazor P="Pinochle2PlayerPlayerItem"
                                  Columns="_scores"
                                  Players="_gameContainer.SaveRoot.PlayerList" />

            </StackItem>
            <StackItem>
                <LabelGridComponent SizeCategory=EnumSize.Small DataContext="_vmData" Labels="_labels" />
            </StackItem>
            <StackItem>
                 <DeckOfCardsHandBlazor HandType="EnumHandList.Vertical"
                                    Divider="1.7"
                                    Hand="_vmData.YourMelds"
                                    TargetContainerSize="50vh"
                                    R="Pinochle2PlayerCardInformation" />
            </StackItem>
            <StackItem>
                <DeckOfCardsHandBlazor HandType="EnumHandList.Vertical"
                                       Divider="1.7"
                                       Hand="_vmData.OpponentMelds"
                                       TargetContainerSize="50vh"
                                       R="Pinochle2PlayerCardInformation" />
            </StackItem>
            
        </StackLayout>
    </div>
    <div class="guide-area">
        <GuideUI GameData="_vmData" />
    </div>
</div>