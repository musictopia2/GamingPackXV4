@inherits CascadingGameView<ClueCardGameMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<ActionContentView Key="@ClueActions.ToggleAccusation">
    <StackLayout>
        <StackItem>
            <HandBlazor Hand="_vmData.PlayerHand1" />
        </StackItem>
        <StackItem>
            <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
        </StackItem>
        <StackItem Length="650px">
            <LabelGridComponent DataContext="_vmData" Labels="_labels" />
            <StackLayout>
                <StackItem Length="1fr">
                    <GameActionButton Display="@MakeDisplay" UseSuggestedWidth=true CommandObject="MakeCommand" />
                </StackItem>
                <StackItem Length="1fr">
                    <GameActionButton Display="End Turn" UseSuggestedWidth="true" CommandObject="EndTurnCommand" />
                </StackItem>
                <StackItem Length="1fr">
                    <GameActionButton Display="@ToggleDisplay" UseSuggestedWidth="true" CommandObject="ToggleCommand" />
                </StackItem>
            </StackLayout>

        
        
        </StackItem>
        <StackItem Style="margin-left: 10px;">
            <ActionContentView Key="@ClueActions.WhoGaveClue">
                <div style="font-weight: bold;">
                    Play Order
                </div>
                @foreach (var item in _players)
                {
                    <div style="@GetStyle(item)">
                        @item.NickName
                    </div>
                }
            </ActionContentView>
        </StackItem>
    </StackLayout>
    @if (_vmData.Accusation.Visible == false)
    {
        <HandBlazor Hand="_vmData.Prediction" />
    }
    <HandBlazor Hand="_vmData.Accusation" />
    <BasicNotebookComponent AddCommand="AddCommand"
                            PersonalNotebook="_gameContainer.DetectiveDetails!.PersonalNotebook" />
</ActionContentView>