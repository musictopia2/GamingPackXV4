@inherits CascadingGameView<SinisterSixMainViewModel>
<div>
    <GameActionButton SizeCategory=EnumSize.Large CommandObject="RollCommand" Display="Roll Dice" />
    <GameActionButton SizeCategory="EnumSize.Large" CommandObject="EndCommand" Display="End Turn" />
</div>
<div class="@cc1.CenteredFlex" style="height: @Pixels">
    <DiceListConrolBlazor D="EightSidedDice" Cup="@DataContext!.GetCup" PercentHeight="_height" />
</div>
<div>
    <GameActionButton SizeCategory="EnumSize.Large" CommandObject="RemoveCommand" Display="Remove Selected Dice" />
</div>
<LabelGridComponent SizeCategory="EnumSize.Large" DataContext="DataContext.VMData" Labels="_labels" />
<div>
    <ScoreBoardBlazor P="SinisterSixPlayerItem" Columns="@_scores" Players="@DataContext!.PlayerList" />
</div>