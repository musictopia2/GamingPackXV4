<BasicMultiplePilesBlazor D="SkipboCardInformation" Inline="@Inline"
                          AnimationTag="@AnimationTag"
                          Piles="@Piles">
    <CanvasTemplate Context="Card">
        <CardGraphicsBlazor HeightPercent="TargetHeight" DeckObject="Card" />
    </CanvasTemplate>
    <MainTemplate Context="Pile">
        <PrivateBasicIndividualPileBlazor Context="Card" D="SkipboCardInformation" IndividualPile="Pile">
            <CardGraphicsBlazor HeightPercent="TargetHeight"
                                ClickBlank="true"
                                DeckObject="Card"
                                CommandParameter="Pile"
                                CommandObject="Piles!.PileCommand" />
        </PrivateBasicIndividualPileBlazor>
    </MainTemplate>
</BasicMultiplePilesBlazor>