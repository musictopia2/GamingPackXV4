@inherits CascadingGameView<ChooseGenderViewModel>
<EnumPickerBlazor E="EnumGender" Context="Piece" ListPicker="DataContext!.GetGenderPicker">
    <CirclePiece MainColor="@GetColor(Piece.EnumValue)" />
</EnumPickerBlazor>
<div>
    <ActionContentView Key="@LifeActionKeys.Gender">
        <BasePieceGraphics LongestSize="93">
            <CarPieceBlazor Player="DataContext.GetPlayer" />
        </BasePieceGraphics>
    </ActionContentView>
</div>
<LabelGridComponent DataContext="DataContext" Labels="_labels" />