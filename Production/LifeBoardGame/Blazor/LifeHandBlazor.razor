<StateContentView DataContext="Hand">
    @if (Hand!.HandList.All(x => x.IsUnknown == false))
    {
        <BaseHandBlazor D="LifeBaseCard" Hand="Hand"
                        HandType="EnumHandList.Vertical"
                        HeightPixels="TargetHeight.HeightPixels"
                        
                        LegendExtraWidth="20"
                        Context="DeckObject">
            <LifeCardBlazor CommandParameter="DeckObject" HeightPercent="@TargetHeight" DeckObject="DeckObject" CommandObject="Hand!.ObjectSingleClickCommand" />
        </BaseHandBlazor>
        return;
    }
    <BaseHandBlazor D="LifeBaseCard" Hand="Hand"
                    HandType="EnumHandList.Vertical"
                    TargetContainerSize="@HeightPixels"
                    HeightPixels="TargetHeight.HeightPixels"
                    Context="DeckObject"
                    Divider="1.3">
        <LifeCardBlazor CommandParameter="DeckObject" HeightPercent="@TargetHeight" DeckObject="DeckObject" CommandObject="Hand!.ObjectSingleClickCommand" />
    </BaseHandBlazor>
</StateContentView>