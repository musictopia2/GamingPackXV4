<BaseFrameBlazor PaddingHeight="10">
    <LegendContent>
        <CompactLabel>
            @Score!.Text
        </CompactLabel>
    </LegendContent>
    <ChildContent>
        <StackLayout ItemSpacing="10px">
            <StackItem>
                <div class="handGrid">
                    @foreach (var card in Score!.CardList)
                    {
                        <div>
                            <DeckOfCardsImageBlazor HeightPixels="HeightPixels" R="CribbageCard" DeckObject="card" />
                        </div>
                    }
                </div>
            </StackItem>
            <StackItem>
                @foreach (var score in Score!.Scores)
                {
                    <div>@score.Description - @score.Points</div>
                }
            </StackItem>
        </StackLayout>
    </ChildContent>
    
</BaseFrameBlazor>