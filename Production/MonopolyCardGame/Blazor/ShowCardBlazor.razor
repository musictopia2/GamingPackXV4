@using BasicGameFrameworkLibrary.Blazor.GameGraphics.Base 
@if (GameData == null)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        Card Information
    </LegendContent>
    <ChildContent>
        <div style="width: 50vw">
            <StackLayout>
                <StackItem>
                    <FlexibleDeckRenderComponent D="MonopolyCardGameCardInformation" DeckObject="GameData.AdditionalInfo1.CurrentCard">
                        <CardGraphicsBlazor HeightPercent="TargetHeight" DeckObject="GameData.AdditionalInfo1.CurrentCard" />
                    </FlexibleDeckRenderComponent>
                </StackItem>
                <StackItem>
                    @GameData.AdditionalInfo1.CurrentCard.Description
                </StackItem>
            </StackLayout>
        </div>
    </ChildContent>
</BaseFrameBlazor>