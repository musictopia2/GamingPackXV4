<div @onclick="ChooseClick">
    <BaseFrameBlazor Text=@GetText>
        <LegendContent>
            @GetText
        </LegendContent>
        <ChildContent>
            @for (int i = 0; i < HowMany; i++)
            {
                <CardGraphicsBlazor DeckObject="RailRoad" HeightPercent="25" />
            }
        </ChildContent>
    </BaseFrameBlazor>
</div>