@using BasicGameFrameworkLibrary.Blazor.GameGraphics.Base
@if (Hand is null)
{
    return;
}
<div @key="Hand" style="@GetContainerStyle()">
    <div style="@GetContentStyle()">
        @for (int i = 0; i < Hand.HandList.Count; i++)
        {
            var item = Hand.HandList[i];
            <div @key="item" style="@GetCardStyle(i)">
                <FlexibleDeckRenderComponent D="MonopolyCardGameCardInformation" DeckObject="item">
                    @ChildContent!(item)
                </FlexibleDeckRenderComponent>
            </div>
        }
    </div>
</div>
