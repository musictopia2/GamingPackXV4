<StateContentView DataContext="Waste">
    @if (Waste == null || Waste.CardList.Count != 4 || _points.Count != 4)
    {
        return;
    }
    @{
        int x = 0;
    }
    @foreach (var card in Waste.CardList)
    {
        var point = _points[x];
        <svg x="@point.X" y="@point.Y">
            <DeckOfCardsImageBlazor Location="point" PartOfBoard="true" DeckObject="card" @key="card.Deck" R="SolitaireCard" />
        </svg>
        
        x++;
    }
</StateContentView>