<SpaceBlazor OnClicked="() => PossibleUtilityClick(EnumUtilityType.Water)"
             MarginTop="8" Column="4" Row="3">
    @{
        var dice = GetWaterDiceUsed();
    }
    <ColorSpaceComponent Border="@GetUtilityBorder"
                         HeightPercent="HeightPercent"
                         Color="@GetUtilityColor">
        <BasicDiceBlazor Dice="dice"
                         HeightPercent="HeightPercent"
                         OnBoardNotOwned="@(!HadWater())" />
    </ColorSpaceComponent>
</SpaceBlazor>

