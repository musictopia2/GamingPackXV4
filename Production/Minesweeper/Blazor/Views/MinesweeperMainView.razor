@inherits CascadingGameView<MinesweeperMainViewModel>
<StackLayout>
    <StackItem>
        <GameboardBlazor StateChanged="ShowChange" />
    </StackItem>
    <StackItem>
        <ActionContentView Key="@MinesweeperActions.Command">
            <GameActionButton Display="@GetDisplay()"
                              CommandObject="DataContext!.ChangeFlagCommand"
                              BackgroundColor="@BackgroundColor()" />
        </ActionContentView>
        <div>
            <LabelGridComponent DataContext="DataContext" Labels="_labels" />
        </div>
    </StackItem>
</StackLayout>