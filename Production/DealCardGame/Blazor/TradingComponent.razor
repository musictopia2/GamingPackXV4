<OpponentPropertiesComponent PlayerChosen="DataContext!.GetChosenPlayer"
                             Command="DataContext.GetCommandContainer"
                             Color="@DataContext.TradeInfo.OpponentColor"
                             OnCardChosen="OpponentPropertyChosen" />

<div>
    <HandBlazor TargetContainerSize="30vw" Hand="@_hand" />
</div>
<div>
    <BaseFrameBlazor>
        <LegendContent>
            @YourText
        </LegendContent>
        <ChildContent>
            <CardGraphicsBlazor DeckObject="@YourCard()" HeightPercent="ImageHeight" />
        </ChildContent>
        
    </BaseFrameBlazor>
    <BaseFrameBlazor>
        <LegendContent>
            @TradeText
        </LegendContent>
        <ChildContent>
            <CardGraphicsBlazor DeckObject="@TradeCard()" HeightPercent="ImageHeight" />
        </ChildContent>
        
    </BaseFrameBlazor>
    <GameActionButton Display="Cancel" CommandObject="CancelCommand" />
    <GameActionButton Display="Trade" CommandObject="TradeCommand" />
</div>