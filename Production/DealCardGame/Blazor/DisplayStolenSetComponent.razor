@if (PlayerToDisplay is null)
{
    <div>
        No Player Found
    </div>
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        @DisplayName
    </LegendContent>
    <ChildContent>
        <StackLayout ItemSpacing="0px">
            @{
                var list = CardList;
            }
            @foreach (var item in list)
            {
                <StackItem>
                    <CardGraphicsBlazor DeckObject="item" HeightPercent="ImageHeight" />
                </StackItem>
            }
        </StackLayout>
    </ChildContent>
    
</BaseFrameBlazor>