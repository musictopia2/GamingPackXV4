@inherits CascadingGameView<TileRummyMainViewModel>
<StackLayout>
    <StackItem>
        <BaseBoneyardPileBlazor D="TileInfo"
                                LegendSizingText="Pool (99)"
                                LI="TileShuffler"
                                BoneyardPile="DataContext!.GetPool">
            <TileRummyImageBlazor HeightPercent="8" DeckObject="GetTile" />
        </BaseBoneyardPileBlazor>
    </StackItem>
    <StackItem>
        <GameActionButton StartOnNewLine="true" CommandObject="FirstSetCommand" Display="Create First Sets" />
        <GameActionButton StartOnNewLine="true" CommandObject="CreateNewSetCommand" Display="Create New Set" />
        <GameActionButton StartOnNewLine="true" CommandObject="ResetCommand" Display="Reset Moves" />
        <GameActionButton StartOnNewLine="true" CommandObject="EndCommand" Display="End Turn" />
        <div>
            <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
        </div>
        <div>
            <ScoreBoardBlazor Players="DataContext!.GetPlayers" P="TileRummyPlayerItem" Columns="_scores" />
        </div>
    </StackItem>
    <StackItem>
        <TileRummyTempSetBlazor HeightPercent="22" TempPiles="DataContext!.GetTempTiles" />
    </StackItem>
</StackLayout>
<div>
    <BaseHandBlazor D="TileInfo" TargetContainerSize="95vw" Context="Tile" Hand="DataContext!.GetHand">
        <TileRummyImageBlazor CommandObject="DataContext.GetHand.ObjectSingleClickCommand" CommandParameter="Tile" DeckObject="Tile" />
    </BaseHandBlazor>
</div>
<div>
    <TileRummyMainSetBlazor HeightPercent="40" ContainerWidth="90vw" DataContext="DataContext.GetMainSets" />
</div>