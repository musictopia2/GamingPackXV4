@using BasicGameFrameworkLibrary.Blazor.GameGraphics.Base 
@if (Player == null || GameData == null || _list.Count != 4)
{
    return;
}
<BaseFrameBlazor  IsEnabled="@IsEnabled">
    <LegendContent>
        @Player.NickName
    </LegendContent>
    <ChildContent>
        <div @onclick="() => SorryPlayerAsync()">
            <StackLayout ItemSpacing="0px">
                @foreach (var card in _list)
                {
                    <StackItem>
                        <FlexibleDeckRenderComponent D="SorryCardGameCardInformation" DeckObject="card">
                            <CardGraphicsBlazor HeightPercent="TargetHeight" DeckObject="card" />
                        </FlexibleDeckRenderComponent>
                    </StackItem>
                }
            </StackLayout>
        </div>
    </ChildContent>
    
</BaseFrameBlazor>