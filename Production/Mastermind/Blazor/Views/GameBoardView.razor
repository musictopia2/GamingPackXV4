@inherits ParameterGameView<GameBoardViewModel>
@if (DataContext == null || DataContext.GuessList.Count == 0)
{
    return;
}
<StackLayout ItemSpacing="20px">
    <StackItem>
        @foreach (var guess in DataContext.GuessList)
        {
            <div>
                <GuessUI Guess="@guess" DataContext="DataContext" />
            </div>
        }
    </StackItem>
    <StackItem>
        @foreach (var guess in DataContext.GuessList)
        {
            <StateContentView DataContext="guess">
                <div>
                    <HintUI YourGuess="@guess" />
                </div>
            </StateContentView>
        }
    </StackItem>
</StackLayout>