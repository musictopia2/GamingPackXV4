@if (DataContext == null)
{
    return;
}
<BaseFrameBlazor FullFrame="true" PaddingHeight="10">
    <LegendContent>
        @TempSetName
    </LegendContent>
    <ChildContent>
        <StateContentView DataContext="DataContext.HandList">
            @if (DataContext.HandList.Count == 0)
            {
                <div style="height: @TargetHeight">
                </div>
            }
            else
            {
                <StackLayout>
                    @foreach (var dice in DataContext.HandList)
                    {
                        <StackItem>
                            <RummyGraphicsBlazor DiceInfo="@dice" OnClick="OnClickAsync" TargetHeight="@TargetHeight" />
                        </StackItem>
                    }
                </StackLayout>
            }
        </StateContentView>
        <div>
            <GameActionButton Display="Place Tiles" CommandObject="DataContext.BoardCommand" />
        </div>
    </ChildContent>
    
    
</BaseFrameBlazor>