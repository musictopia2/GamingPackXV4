@inherits SimpleActionView<ActionDiscardRulesViewModel>

@if (CompleteContainer == null || DataContext == null)
{
    return;
}
<FinalActionLayout>
    <div>
        <LabelGridComponent DataContext="DataContext" Labels="_labels" />
    </div>
    <StackLayout>
        <StackItem>
            <div style="width: 50vw; height: @_realHeight; overflow: auto">
                <ListChooserBlazor TextWidth="400" SizeCategory="EnumSize.Small" ListPicker="CompleteContainer.ActionContainer.Rule1" />
            </div>
        </StackItem>
        <StackItem>
            <GameActionButton StartOnNewLine="true"
                                 CommandObject="ViewCommand"
                                 Display="View Card" />
            <GameActionButton StartOnNewLine="true"
                                 CommandObject="DiscardCommand"
                                 Display="Discard Selected Rule(s)" />
            <KeeperButton DataContext="DataContext" @key="GetKey" StartsOnNewLine="true" />
        </StackItem>
    </StackLayout>
</FinalActionLayout>