@inherits SimpleActionView<ActionDirectionViewModel>
@if (CompleteContainer == null || DataContext == null)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        Direction
    </LegendContent>
    <ChildContent>
        <FinalActionLayout>
            <div>
                <ListChooserBlazor ListPicker="CompleteContainer.ActionContainer.Direction1" />
            </div>
            <div>
                <GameActionButton CommandObject="DirectionCommand"
                                  Display="Choose Direction" />
                <KeeperButton @key="GetKey" DataContext="DataContext" />
            </div>
        </FinalActionLayout>
    </ChildContent>
</BaseFrameBlazor>