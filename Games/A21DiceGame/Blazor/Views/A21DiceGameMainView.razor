@inherits CascadingGameView<A21DiceGameMainViewModel>
<div class="@cc1.CenteredFlex" style="height: @HeightPixels">
    <GameActionButton SizeCategory="EnumSize.Large" CommandObject="RollCommand" Display="Roll Dice" />
    <GameActionButton SizeCategory="EnumSize.Large" CommandObject="EndCommand" Display="End Turn" />
    <DiceListConrolBlazor D="SimpleDice" Cup="@DataContext!.GetCup" PercentHeight="35" />
</div>
<LabelGridComponent SizeCategory="EnumSize.Large" DataContext="DataContext.VMData" Labels="_labels" />
<div>
    <ScoreBoardBlazor SizeCategory="EnumSize.Large" P="A21DiceGamePlayerItem" Columns="@_scores" Players="@DataContext!.PlayerList" />
</div>