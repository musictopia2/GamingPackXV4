@inherits CascadingGameView<MonopolyCardGameMainViewModel>
@if (OppenentUsed is null)
{
    <div>
        Needs opponent
    </div>
    return;
}
<GridContainer Columns="auto 1fr 65vw">
    <GridItem Column="1">
        <StackLayout ItemSpacing="10px">
            <StackItem>
                <HandBlazor Hand="Model!.TempHand1" Divider=1.5 HandType="EnumHandList.Vertical" TargetContainerSize="85vh" />
            </StackItem>
            <StackItem>
                <div>
                    <GameActionButton Display="Cancel Trade" UseSuggestedWidth="true" CustomCallBack="OnCancelled" />
                </div>
                @if (_used > 0)
                {
                    <div>
                        <GameActionButton Display="Confirm Trade" UseSuggestedWidth="true" CustomCallBack="ConfirmTrade" />
                    </div>
                }
            </StackItem>
        </StackLayout>
    </GridItem>
    <GridItem Column="2">
        @if (_proposedOpponent.Count > 0 && _proposedYours.Count > 0)
        {
            <StackLayout>
                <StackItem>
                    <BaseFrameBlazor>
                        <LegendContent>
                            @SelfPlayer!.NickName
                        </LegendContent>
                        <ChildContent>
                            <LeftOverLayout>
                                <MainContent>
                                    @foreach (var item in _proposedOpponent)
                                    {
                                        <div>
                                            <CardGraphicsBlazor DeckObject="item" HeightPercent="TargetHeight" />
                                        </div>

                                    }
                                </MainContent>
                            </LeftOverLayout>
                        </ChildContent>
                        

                    </BaseFrameBlazor>
                </StackItem>
                <StackItem>
                    <BaseFrameBlazor>
                        <LegendContent>
                            @OppenentUsed.NickName
                        </LegendContent>
                        <ChildContent>
                            <LeftOverLayout>
                                <MainContent>
                                    @foreach (var item in _proposedYours)
                                    {
                                        <div>
                                            <CardGraphicsBlazor DeckObject="item" HeightPercent="@TargetHeight" />
                                        </div>

                                    }
                                </MainContent>
                            </LeftOverLayout>
                        </ChildContent>
                        
                    </BaseFrameBlazor>
                </StackItem>
            </StackLayout>
        }
    </GridItem>
    <GridItem Column="3">
        <BaseFrameBlazor>
            <LegendContent>
                @StartText
            </LegendContent>
            <ChildContent>
                <div style="width: 60vw; height: @Pixels;">
                    <LeftOverLayout>
                        <MainContent>
                            <WrapLayout ColumnWidth="6vw" RenderList="_opponentCards" Context="Card">
                                <div @onclick="() => ClickCard(Card)">
                                    <CardGraphicsBlazor DeckObject="Card" HeightPercent="@TargetHeight" />
                                </div>
                            </WrapLayout>
                        </MainContent>
                    </LeftOverLayout>
                </div>
            </ChildContent>
            
        </BaseFrameBlazor>
        <TempSetsBlazor TargetHeight="@Pixels"
                        HeightPixels="TemporaryCardHeight"
                        TargetContainerSize="60vw"
                        Mode="EnumMode.Plain"
                        Divider="1.1"
                        TempPiles="Model!.TempSets1" />
    </GridItem>
</GridContainer>