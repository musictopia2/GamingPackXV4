<div style="height: @Pixels;">
    <LeftOverLayout>
        <MainContent>
            @foreach (var item in Calculations)
            {
                <GridContainer  Columns="15vw auto">
                    <GridItem Column="1">
                        <StackLayout>
                            @{
                                var cards = GetCards(item);
                            }
                            @foreach (var item in cards)
                            {
                                <StackItem>
                                    <CardGraphicsBlazor DeckObject="item" HeightPercent="12" />
                                </StackItem>
                            }
                        </StackLayout>
                    </GridItem>
                    <GridItem Column="2">
                        <GameLabel SizeCategory="EnumSize.Large">
                            @GetTotal(item)
                        </GameLabel>

                    </GridItem>
                </GridContainer>
            }
        </MainContent>
    </LeftOverLayout>
</div>