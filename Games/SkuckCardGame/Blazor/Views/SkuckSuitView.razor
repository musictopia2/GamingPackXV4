@inherits ParameterGameView<SkuckSuitViewModel>
@if (DataContext == null)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        Trump Info
    </LegendContent>
    <ChildContent>
        <EnumPickerBlazor E="EnumSuitList"
                          Context="piece"
                          ListPicker="DataContext.Model.Suit1">
            <DeckPiece Suit="piece.EnumValue" />
        </EnumPickerBlazor>
    <div>
        <GameActionButton CommandObject="TrumpCommand"
                             Display="Choose Trump Suit" />
    </div>
    </ChildContent>
    
</BaseFrameBlazor>