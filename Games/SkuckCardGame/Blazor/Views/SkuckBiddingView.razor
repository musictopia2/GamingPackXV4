@inherits ParameterGameView<SkuckBiddingViewModel>
@if (DataContext == null)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        Bid Info
    </LegendContent>
    <ChildContent>
    <NumberChooserBlazor Columns="9"
                         NumberPicker="DataContext.Model.Bid1"
                         />
    <div>
        <GameActionButton CommandObject="BidCommand"
                             Display="Place Bid" />
    </div>
    </ChildContent>
    
</BaseFrameBlazor>