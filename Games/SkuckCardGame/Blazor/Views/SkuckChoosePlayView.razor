@inherits ParameterGameView<SkuckChoosePlayViewModel>
@if (DataContext == null)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>

    </LegendContent>
    <ChildContent>
        <GameActionButton CommandObject="PlayCommand"
                          StartOnNewLine="true"
                          CommandParameter="EnumChoiceOption.Play"
                          Display="Play" />
        <GameActionButton CommandObject="PlayCommand"
                          StartOnNewLine="true"
                          CommandParameter="EnumChoiceOption.Pass"
                          Display="Pass" />
    </ChildContent>
    
</BaseFrameBlazor>