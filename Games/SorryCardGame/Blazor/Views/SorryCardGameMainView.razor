@inherits CascadingGameView<SorryCardGameMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<CascadingValue Value="_gameContainer">
    <StackLayout>
        <StackItem>
            <DrawPileBlazor DeckPile="_vmData.Deck1" />
        </StackItem>
        <StackItem>
            <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
        </StackItem>
        <StackItem>
            <SingleMiscPileBlazor PileAnimationTag="otherpile" SinglePile="_vmData.OtherPile" />
        </StackItem>
        <StackItem>
            <StateContentView DataContext="_vmData">
                <div style="font-weight: bold; font-size: 8vh;">
                    @_vmData.UpTo
                </div>
            </StateContentView>
            
        </StackItem>
    </StackLayout>
    <div>
        <HandBlazor Hand="_vmData.PlayerHand1" />
    </div>
    <StackLayout>
        @foreach (var player in _playerList)
        {
            <StackItem>
                <StateContentView DataContext="player">
                    <BoardBlazor Player="player" />
                </StateContentView>
                
            </StackItem>
        }
    </StackLayout>
    <div>
        <LabelGridComponent DataContext="_vmData" Labels="_labels" />
    </div>
</CascadingValue>