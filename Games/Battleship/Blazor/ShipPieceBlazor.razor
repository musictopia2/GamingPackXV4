<StateContentView DataContext="Piece">
    <rect x="@X" fill="@PieceColor" y="0" width="60" height="60" style="stroke: black; stroke-width: 4px" />
    <svg x="@X" y="0" width="60" height="60">
        <text x="50%" y="55%" font-size="30px" text-anchor="middle" dominant-baseline="middle" style="width: 100%; height: 100%">
            @Piece.Location
        </text>
    </svg>
</StateContentView>