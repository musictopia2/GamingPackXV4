@inherits CascadingGameView<RiskMainViewModel>
<StateContentView DataContext="DataContext!.VMData">
    @if (CanShowBoard)
    {
        <StackLayout>
            <StackItem>
                <GameBoardBlazor HeightPercent="85"
                                 Territories="_container.SaveRoot.TerritoryList"
                                 OnTerritoryClicked="DataContext!.TerritorySelectedAsync" />
            </StackItem>
            <StackItem>
                <div>
                    <ScoreBoardBlazor Players="_container.SaveRoot.PlayerList"
                                      Columns="_scores"
                                      P="RiskPlayerItem" />
                </div>
                @if (_container.SaveRoot.Stage == EnumStageList.EndTurn)
                {
                    <GameActionButton Display="End Turn" CommandObject="EndCommand" />
                }
                else
                {
                    <GameActionButton CommandObject="ToNextStepCommand" Display="Continue Turn" />
                }
                @if (_container.SaveRoot.Stage == EnumStageList.StartAttack)
                {
                    <GameActionButton CommandObject="StartAttackCommand" Display="Start Attack" StartOnNewLine="true" />
                }

                @if ((_container.SaveRoot.Stage == EnumStageList.Move || _container.SaveRoot.Stage == EnumStageList.TransferAfterBattle) && _container.SaveRoot.PreviousTerritory > 0 && _container.SaveRoot.CurrentTerritory > 0)
                {
                    <div>
                        <NumberChooserBlazor Columns="5" NumberPicker="DataContext!.VMData.NumberPicker" />
                    </div>
                    <div>
                        <GameActionButton Display="Move Armies" CommandObject="MoveArmiesCommand" />
                    </div>
                }
                else if (_container.SaveRoot.Stage == EnumStageList.Place && _container.SaveRoot.PreviousTerritory > 0)
                {
                    <div>
                        <NumberChooserBlazor Columns="5" SizeCategory="EnumSize.Large" NumberPicker="DataContext!.VMData.NumberPicker" />
                    </div>
                    <div>
                        <GameActionButton Display="Place Armies" CommandObject="PlaceArmiesCommand" />
                    </div>
                }
                else
                {
                    <div>
                        <RiskHandBlazor Hand="DataContext!.VMData.PlayerHand1" />
                    </div>
                }
                @if (_container.SaveRoot.Stage == EnumStageList.Begin)
                {
                    <GameActionButton Display="Return Risk Cards" StartOnNewLine="true" CommandObject="ReturnRiskCardsCommand" />
                }
            </StackItem>
        </StackLayout>
        <StackLayout>
            <StackItem>
                <BasePieceGraphics HeightPercent="15">
                    <ArmyColorComponent MainColor="@CurrentColor" />
                </BasePieceGraphics>
            </StackItem>
            <StackItem Length="1fr">
                <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
            </StackItem>
        </StackLayout>
        return;
    }
    @if (_container.SaveRoot.Stage == EnumStageList.Roll)
    {
        <AttackViewBlazor />
        return;
    }
</StateContentView>