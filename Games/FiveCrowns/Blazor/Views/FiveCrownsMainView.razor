@inherits CascadingGameView<FiveCrownsMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout>
    <StackItem>
        <HandBlazor Hand="_vmData.PlayerHand1" TargetContainerSize="50vw" AdditionalSpacing="1" />
    </StackItem>
    <StackItem>
        <GameActionButton CommandObject="LayDownCommand"
                             Display="Lay Down"
                             StartOnNewLine="true" />
        <GameActionButton CommandObject="BackCommand"
                             Display="Back"
                             StartOnNewLine="true" />
    </StackItem>
    <StackItem>
        <DrawPileBlazor DeckPile="_vmData.Deck1" />
    </StackItem>
    <StackItem>
        <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
    </StackItem>
    <StackItem Length="1fr">
        <LabelGridComponent SizeCategory="EnumSize.Small" DataContext="_vmData" Labels="_labels" />
    </StackItem>
</StackLayout>
<div>
    <ScoreBoardBlazor P="FiveCrownsPlayerItem"
                      Columns="_scores"
                      Players="_gameContainer.SaveRoot.PlayerList" />
</div>
<StackLayout>
    <StackItem>
        <TempSetsBlazor HeightPercent="60"
                        TempPiles="_vmData.TempSets" />
    </StackItem>
    <StackItem>
        <MainRummySetsBlazor HeightPercent="60"
                             DataContext="_vmData.MainSets" />
    </StackItem>
</StackLayout>