@inherits CascadingGameView<PaydayMainViewModel>
<ActionContentView Key="@PaydayActions.FirstLoad">

    @if (DataContext == null || _graphicsData == null || _graphicsData!.GameContainer.SingleInfo == null)
    {
        return;
    }
    <CascadingValue Value="DataContext.VMData">
        <div style="padding-right: 5px; box-sizing: border-box;">
            <GridContainer Columns="@GetColumns">
                <GridItem>
                    <GameBoardBlazor GraphicsData="_graphicsData"
                                     TargetHeight="100" />
                </GridItem>
                <GridItem Column="2">
                    <GridContainer Rows="@RowData">
                        <GridItem>
                            <GridContainer ColumnGap="5px" Columns="20vw 1fr auto">
                                <GridItem>
                                    <StateContentView DataContext="DataContext">
                                        @if (DataContext.ShowMailPile)
                                        {
                                            <MailPileView />
                                        }
                                        @if (DataContext.ShowDealPile)
                                        {
                                            <DealPileView />
                                        }
                                        <RollerView DataContext="DataContext.RollerScreen" />
                                    </StateContentView>
                                </GridItem>
                                <GridItem Column="2">
                                    <StateContentView DataContext="DataContext.VMData">
                                        <div>
                                            Instructions:
                                        </div>
                                        <div style="overflow-y: auto; height: @InstructionsHeight;">
                                            @DataContext.VMData.Instructions
                                        </div>
                                    </StateContentView>

                                </GridItem>
                                <GridItem Column="3">
                                    <ScoreBoardBlazor P="PaydayPlayerItem"
                                                      SizeCategory="EnumSize.Small"
                                                      Players="_graphicsData.GameContainer.SaveRoot.PlayerList"
                                                      Columns="_scores" />
                                </GridItem>
                            </GridContainer>
                        </GridItem>
                        <GridItem Row="2">
                            <StackLayout>
                                <StackItem>
                                    <BaseHandBlazor TargetContainerSize="@DealListHeight" D="DealCard" HeightPixels="@TargetHeight.HeightPixels" HandType="EnumHandList.Vertical" UseKey="false" Hand="DataContext.VMData.CurrentDealList" Context="DeckObject">
                                        <PaydayCardBlazor CommandParameter="DeckObject"
                                                          DeckObject="DeckObject"
                                                          HeightPercent="TargetHeight"
                                                          CommandObject="DataContext.VMData.CurrentDealList.ObjectSingleClickCommand" />
                                    </BaseHandBlazor>
                                </StackItem>
                                <StackItem>
                                    <StateContentView DataContext="DataContext">
                                        @if (DataContext.ShowMailList)
                                        {
                                            <MailListView />
                                        }
                                        <BasicPickerView DataContext="DataContext.BuyDealScreen" />
                                        <BasicPickerView DataContext="DataContext.ChooseDealScreen" />
                                        <BasicPickerView DataContext="DataContext.LotteryScreen" />
                                        <BasicPickerView DataContext="DataContext.PlayerScreen" />
                                        <BasicPickerView DataContext="DataContext.DealOrBuyScreen" />
                                    </StateContentView>
                                </StackItem>
                            </StackLayout>
                        </GridItem>
                        <GridItem Row="3">
                            <StackLayout>
                                <StackItem>
                                    <ActionContentView Key="@PaydayActions.Turn">
                                        <BasePieceGraphics LongestSize="60" HeightPercent="12">
                                            <PawnPiece MainColor="@GetColor" />
                                        </BasePieceGraphics>
                                    </ActionContentView>
                                </StackItem>
                                <StackItem>
                                    <LabelGridComponent SizeCategory="EnumSize.Small" DataContext="DataContext.VMData" Labels="_labels" />
                                </StackItem>
                            </StackLayout>
                        </GridItem>
                    </GridContainer>
                </GridItem>
            </GridContainer>
        </div>
        
    </CascadingValue>
</ActionContentView>