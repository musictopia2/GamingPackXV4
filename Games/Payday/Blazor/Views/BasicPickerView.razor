@typeparam V
@inherits BasicSubmitView<V>
@if (VMData is null || DataContext is null)
{
    return;
}
<ActionContentView Key="@PaydayActions.Popups">

    

    <StackLayout>
        <StackItem>
            <ListChooserBlazor TextHeight="6vh" ListPicker="VMData.PopUpList" />
        </StackItem>
        <StackItem>
            <GameButtonComponent CommandObject="SubmitCommand"
                                 Display="Submit" />
        </StackItem>
    </StackLayout>
</ActionContentView>