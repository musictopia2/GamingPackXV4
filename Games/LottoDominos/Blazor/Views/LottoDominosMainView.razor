@inherits CascadingGameView<LottoDominosMainViewModel>
<StateContentView DataContext="DataContext!.MainView">
    @if (DataContext.MainView.MainPlay)
    {
        <MainBoardView />
    }
    else if (DataContext.ChooseNumber is not null)
    {
        <ChooseNumberView DataContext="DataContext.ChooseNumber" />
    }
</StateContentView>
<div>
    <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
</div>
<div>
    <ScoreBoardBlazor P="LottoDominosPlayerItem" Players="DataContext!.GetPlayers" Columns="_scores" />
</div>