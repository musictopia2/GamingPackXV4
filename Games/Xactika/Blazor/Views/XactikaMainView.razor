@inherits CascadingGameView<XactikaMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout>
    <StackItem Length="1fr">
        <StackLayout>
            <StackItem>
                <SeveralPlayersTrickBlazor DataContext="_vmData.TrickArea1" />
            </StackItem>
            <StackItem>
                @* Keep space for the chooser even when it is hidden or empty. *@
                <div style="min-height: @(22.HeightPixels + 8)px;">
                    <ChooseShapeBlazor TargetHeight="22"
                                       ShapeData="_vmData.ShapeChoose1" />
                </div>
                @* Reserve the actual device-sized submit button height while absent. *@
                <div style="display: grid;">
                    <div style="grid-area: 1 / 1; visibility: hidden;" aria-hidden="true">
                        <GameActionButton Display="Choose Shape" SizeCategory="default(EnumSize)" />
                    </div>
                    <div style="grid-area: 1 / 1;">
                        <XactikaSubmitShapeView DataContext="DataContext.ShapeScreen" />
                    </div>
                </div>
                <XactikaBidView DataContext="DataContext.BidScreen" />
            </StackItem>
        </StackLayout>
        <div>
            <HandBlazor Hand="_vmData.PlayerHand1" />
        </div>
        <div>
            <LabelGridComponent DataContext="_vmData" Labels="_labels" />
        </div>
    </StackItem>
    <StackItem>
        <StackLayout>
            <StackItem>
                <ScoreBoardBlazor P="XactikaPlayerItem"
                              Columns="_scores"
                              Players="_gameContainer.SaveRoot.PlayerList" />
            </StackItem>
            <StackItem>
                <RawGameBoard BoardSize="new SizeF(121, 225)" TargetHeight="85">
                    <StatsBoardBlazor />
                </RawGameBoard>
            </StackItem>
        </StackLayout>
    </StackItem>
</StackLayout>