<BaseDrawPileBlazor D="DealCardGameCardInformation" DeckAnimationTag="@DeckAnimationTag" DeckPile="@DeckPile">
    <CanvasTemplate Context="Card">
        <CardGraphicsBlazor HeightPercent="TargetHeight" DeckObject="Card" />
    </CanvasTemplate>
    <MainTemplate Context="Card">
        <CardGraphicsBlazor ClickBlank="true" @key="Card.Deck" HeightPercent="TargetHeight" DeckObject=" Card" CommandParameter="Card" CommandObject="DeckPile!.DeckObjectClickedCommand" />
    </MainTemplate>
</BaseDrawPileBlazor>