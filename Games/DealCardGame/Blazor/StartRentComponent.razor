@if (DataContext!.NeedsRentPicker)
{
    <EnumPickerBlazor E="EnumRentCategory" SizeCategory="EnumSize.Small" Context="piece" Columns="3" ListPicker="DataContext.RentPicker">
        <RentOptionGraphicsComponent RentCategory="piece" />
    </EnumPickerBlazor>
}
@if (DataContext.NeedsRentPicker && DataContext.NeedsPlayerPicker)
{
    <div style="height: 20px;">

    </div>
}
@if (DataContext.NeedsPlayerPicker)
{
    <ListChooserBlazor SizeCategory="EnumSize.Small" ListPicker="DataContext.GetPlayerPicker" TotalColumns="2" />
}
<StateContentView DataContext="DataContext">
    <div style="background-color: @DataContext.ColorChosen.WebColor; font-size: 2rem;font-family: Lato; -webkit-text-stroke-width: 1px; -webkit-text-stroke-color: black;">
        Rent Charged: @DataContext.RentOwed
    </div>
</StateContentView>
<div>
    <GameActionButton Display="Cancel" CommandObject="CancelCommand" />
    <GameActionButton Display="Collect Rent" CommandObject="ProcessRentCommand" />
</div>