@inherits CascadingGameView<DealCardGameMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<ActionContentView Key="@DealCardGameActions.Main">
    
    @if (_gameContainer.PersonalInformation.NeedsPayment)
    {
        <StackLayout>
            <StackItem>
                <MakePaymentComponent />
            </StackItem>
            <StackItem>
                <CompletePlayerSetsComponent SetCommand=SetChosenCommand Players="GetPlayers()" />
            </StackItem>
        </StackLayout>
        return;
    }
    @if (_gameContainer.PersonalInformation.Organizing)
    {
        <PropertySetOrganizerComponent />
        return;
    }
    <GridContainer ColumnGap="5px" Columns="auto 1fr">
        <GridItem Row="1" Column="1">
            <GridContainer Rows="auto auto" ColumnGap="5px" RowGap="5px" Columns="auto 35vw">
                <GridItem Row="1" Column="1">
                    <StackLayout>
                        <StackItem>
                            <DrawPileBlazor DeckPile="_vmData.Deck1" />
                        </StackItem>
                        <StackItem>
                            <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
                        </StackItem>
                    </StackLayout>
                </GridItem>
                <GridItem Column="2" Row="1">
                    <HandBlazor TargetContainerSize="35vw" Hand="_vmData.PlayerHand1" />
                </GridItem>
                <GridItem Row="2" Column="1" ColumnSpan="2">
                    <div>
                        <GameActionButton Display="Play" CommandObject="PlayCommand" />
                        <GameActionButton Display="End Turn" CommandObject="EndTurnCommand" />
                        <GameActionButton Display="Bank" CommandObject="BankCommand" />
                        <GameActionButton Display="Start Organizing" CommandObject="StartOrganizingCommand" />
                    </div>
                    <div>
                        <LabelGridComponent DataContext="_vmData" Labels="_labels" />
                    </div>
                    <div>
                        <ScoreBoardBlazor P="DealCardGamePlayerItem"
                                          Columns="_scores"
                                          Players="_gameContainer.SaveRoot.PlayerList" />
                    </div>
                    @if (_gameContainer.SaveRoot.GameStatus == EnumGameStatus.ConsiderJustSayNo && _gameContainer.IsJustSayNoSelf)
                    {
                        <JustSayNoComponent />
                        return;
                    }
                    @if (_gameContainer.PersonalInformation.RentInfo.RentCategory != EnumRentCategory.NA)
                    {
                        <StartRentComponent />
                        return;
                    }
                    @if (_gameContainer.PersonalInformation.StealInfo.StartStealing)
                    {
                        <StealingComponent />
                        return;
                    }
                    @if (_gameContainer.PersonalInformation.TradeInfo.StartTrading)
                    {
                        <TradingComponent />
                        return;
                    }
                    @if (DataContext.VMData.TradeDisplay is not null)
                    {
                        <div>
                            <BaseFrameBlazor>
                                <LegendContent>
                                    @YourDisplayText
                                </LegendContent>
                                <ChildContent>
                                    <CardGraphicsBlazor DeckObject="DataContext.VMData.TradeDisplay.WhoReceive" HeightPercent="ImageHeight" />
                                </ChildContent>
                        
                            </BaseFrameBlazor>
                            <BaseFrameBlazor>
                                <LegendContent>
                                    @OpponentDisplayText
                                </LegendContent>
                                <ChildContent>
                                    <CardGraphicsBlazor DeckObject="DataContext.VMData.TradeDisplay.TradeReceive" HeightPercent="ImageHeight" />
                                </ChildContent>
                            </BaseFrameBlazor>
                        </div>

                        return;
                    }
                    @if (_gameContainer.SaveRoot.GameStatus == EnumGameStatus.StartDebtCollector)
                    {
                        <ListChooserBlazor ListPicker="DataContext.VMData.PlayerPicker" TotalColumns="1" />
                        <GameActionButton Display="Choose Player" CommandObject="ChoosePlayerCommand" />
                        return;
                    }
                    <StateContentView DataContext="_vmData">
                        @if (_vmData.ShownCard is not null)
                        {
                            <CardGraphicsBlazor DeckObject="_vmData.ShownCard" HeightPercent="ImageHeight" />
                        }
                        @if (_vmData.ChosenPlayer is not null)
                        {
                            <div style="font-size: 2rem;">
                                @_vmData.ChosenPlayer
                            </div>
                            @if (_vmData.StolenCards.HandList.Count > 0)
                            {
                                <HandBlazor TargetContainerSize="35vw" Hand="_vmData.StolenCards" />
                            }
                        }
                    </StateContentView>
            
                    @if (_gameContainer.SaveRoot.GameStatus == EnumGameStatus.ConfirmPayment)
                    {
                        <HandBlazor TargetContainerSize="35vw" Hand="_vmData.ReceivedPayments" />
                        <div>
                            <GameActionButton Display="Resume" CommandObject="ResumeCommand" />
                        </div>
                    }
                </GridItem>
            </GridContainer>
        </GridItem>
        <GridItem Column="2" Row="1">
            <CompletePlayerSetsComponent SetCommand=SetChosenCommand Players="GetPlayers()" />
        </GridItem>

    </GridContainer>

</ActionContentView>