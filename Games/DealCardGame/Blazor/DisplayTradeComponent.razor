<div style="font-size: 1.5rem;">
    @DisplayName
</div>
<div>
    <BaseFrameBlazor>
        <LegendContent>
            @_mainPlayer!.NickName
        </LegendContent>
        <ChildContent>
            <CardGraphicsBlazor HeightPercent="ImageHeight" DeckObject="_yourCard" />
        </ChildContent>
    </BaseFrameBlazor>
    <BaseFrameBlazor>
        <LegendContent>
            @_tradePlayer!.NickName
        </LegendContent>
        <ChildContent>
            <CardGraphicsBlazor HeightPercent="ImageHeight" DeckObject="_opponentCard" />
        </ChildContent>
    </BaseFrameBlazor>
</div>