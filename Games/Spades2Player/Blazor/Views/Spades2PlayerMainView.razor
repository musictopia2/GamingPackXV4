@inherits CascadingGameView<Spades2PlayerMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<SpadesBeginningView DataContext="DataContext.BeginningScreen" />
<div>
    <DeckOfCardsTwoPlayerTrickBlazor T="Spades2PlayerCardInformation" DataContext="_vmData.TrickArea1" />
</div>
<SpadesBiddingView DataContext="DataContext.BiddingScreen" />
<div>
    <DeckOfCardsHandBlazor R="Spades2PlayerCardInformation"
        AdditionalSpacing="1"
        Hand="_vmData.PlayerHand1" />
</div>
<div>
    <LabelGridComponent DataContext="_vmData" Labels="_labels" />
</div>
<div>
    <ScoreBoardBlazor P="Spades2PlayerPlayerItem"
                      Columns="_scores"
                      Players="_gameContainer.SaveRoot.PlayerList" />
</div>