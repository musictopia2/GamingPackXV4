<StateContentView DataContext="OpponentShip">
    @{
        string location = YourShip.ShipLocation;
    }
    <rect x="0" fill="@PieceColor(YourShip)" y="@Y" width="200" height="60" style="stroke: black; stroke-width: 4px" />
    <svg x="0" y="@Y" width="200" height="60">
        <text x="50%" y="55%" font-size="60px" text-anchor="middle" dominant-baseline="middle" style="width: 100%; height: 100%">
            @location
        </text>
    </svg>
</StateContentView>