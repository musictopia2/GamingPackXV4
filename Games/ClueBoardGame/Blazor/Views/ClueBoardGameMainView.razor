@using BasicBlazorLibrary.Components.Arrows;
@inherits CascadingGameView<ClueBoardGameMainViewModel>
<GridContainer RowGap="5px" Columns="auto auto calc(10vw + 10px) 1fr">
    <GridItem>
        <GameBoardBlazor GraphicsData="_graphicsData"
                         TargetHeight="100" />

    </GridItem>
    <GridItem Column="2">
        <ClueHandBlazor Hand="DataContext!.GetHand" />
        <div>

            
            <StateContentView DataContext="DataContext.VMData">
                <CascadingValue Value="EnumDetectiveCategory.Prediction">
                    <DetectiveGraphicsBlazor DetectiveList="_graphicsData!.GameContainer!.DetectiveList" />
                </CascadingValue>
            </StateContentView>
            @* <ActionContentView Key="@ClueActions.Prediction">
                
            </ActionContentView> *@
        </div>
        <div style="margin-top: 20px">
            <ActionContentView Key="@ClueActions.Notebook">
                <CascadingValue Value="EnumDetectiveCategory.Notebook">
                    <DetectiveGraphicsBlazor DetectiveList="DataContext.GetOwnDetectiveNotebook()" />
                </CascadingValue>
            </ActionContentView>
            
        </div>
        <GridContainer Columns="auto auto">
            <ActionContentView Key="@ClueActions.Turn">
                <BasePieceGraphics LongestSize="50" HeightPercent="5">
                    <PawnPiece MainColor="@GetColor()" />
                </BasePieceGraphics>
            </ActionContentView>
            <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
        </GridContainer>
    </GridItem>
    <GridItem Column="3">
        <ActionContentView Key="@ClueActions.Given">
            <CluePileBlazor SinglePile="DataContext!.GetPile" />
        </ActionContentView>
        <GameActionButton CommandObject="RollCommand" StartOnNewLine="true" Display="Roll Dice" />
        <div style="width: max-content; margin: 0 5px;">
            <ArrowCompleteComponent ArrowCategory="EnumArrowCategory.All"
                                    DownClicked="DataContext!.DownArrowAsync"
                                    UpClicked="DataContext.UpArrowAsync"
                                    LeftClicked="DataContext.LeftArrowAsync"
                                    RightClicked="DataContext.RightArrowAsync"
                                    BackgroundColor="aqua"
                                    TargetHeight="@Arrows" />
        </div>
        <div class="@css1.CenteredFlex" style="font-size: @Pixels; color: white">
            <StateContentView DataContext="DataContext.VMData">
                @DataContext!.VMData.LeftToMove
            </StateContentView>
            
            <DiceListConrolBlazor D="SimpleDice" Cup="@DataContext!.GetCup" PercentHeight="@_height" />
        </div>
        
        <div style="font-weight: bold;">
            Play Order
        </div>
        @foreach (var item in _players)
        {
            <div>
                @item.NickName
            </div>
        }
        
        
    </GridItem>
    <GridItem Column="4">
        <div style="margin-top: @Fins">
            <GameActionButton CommandObject="AccusationCommand" StartOnNewLine="true" Display="Accusation" />
            <div style="margin-top: 30px;">

            </div>
            <GameActionButton CommandObject="StartOverCommand" StartOnNewLine="true" Display="Start Over" />
            <GameActionButton CommandObject="PredictCommand" StartOnNewLine="true" Display="Predict" />
            
            <GameActionButton CommandObject="EndCommand" StartOnNewLine="true" Display="End Turn" />
            <LabelGridComponent SizeCategory="EnumSize.Small" DataContext="DataContext!.VMData" Labels="_clues" />
        </div>
    </GridItem>
</GridContainer>