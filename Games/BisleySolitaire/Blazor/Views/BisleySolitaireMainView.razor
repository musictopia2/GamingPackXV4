@inherits CascadingGameView<BisleySolitaireMainViewModel>
@if (DataContext!.DeckPile != null)
{
    <GameActionButton CommandObject="@DataContext.AutoMoveCommand" Display="Auto Make Move" />
    <LabelGridComponent DataContext="@DataContext" Labels="@_labels" />

    <GridEvenContent Rows="5" Columns="13" Inline="true">
        <DeckOfCardsMultiplePilesBlazor
            R="SolitaireCard"
            Piles="@GetMainPiles()"
            UseOwnGrid="false" />

        <DeckOfCardsMultiplePilesBlazor
            R="SolitaireCard"
            Piles="@GetWastePiles()"
            UseOwnGrid="false"
            RowOffset="1" />
    </GridEvenContent>
}