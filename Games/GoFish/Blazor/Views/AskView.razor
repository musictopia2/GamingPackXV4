@inherits ParameterGameView<AskViewModel>
@if (Model == null || DataContext == null || Model.AskList.ItemList.Count == 15)
{
    return;
}
<BaseFrameBlazor>
    <LegendContent>
        Choose Number To Ask
    </LegendContent>
    <ChildContent>
        <EnumPickerBlazor E="EnumRegularCardValueList"
                          SizeCategory="EnumSize.Small"
                          Context="Item"
                          ListPicker="Model.AskList">
            <GoFishPieceBlazor Value="Item.EnumValue" />
        </EnumPickerBlazor>
        <div>
            <GameActionButton Display="Number To Ask" CommandObject="AskCommand" />
        </div>
    </ChildContent>
</BaseFrameBlazor>