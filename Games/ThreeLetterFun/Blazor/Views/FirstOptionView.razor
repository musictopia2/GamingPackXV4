@inherits ParameterGameView<FirstOptionViewModel>
@if (DataContext == null)
{
    return;
}
<div style="margin-top: 5px;">
    <ListChooserBlazor ListPicker="DataContext.Option1" TextWidth="100" SizeCategory="EnumSize.Large"/>
</div>
<StackLayout ItemSpacing="10px">
    <StackItem>
        <GameActionButton SizeCategory="EnumSize.Large" Display="Submit" CommandObject="DataContext.SubmitCommand" />
    </StackItem>
    <StackItem>
        <GameActionButton SizeCategory="EnumSize.Large" Display="Description" CommandObject="DataContext.DescriptionCommand" />
    </StackItem>
</StackLayout>