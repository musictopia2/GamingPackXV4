@inherits CascadingGameView<ConnectFourMainViewModel>
@using cc1 = CommonBasicLibraries.BasicDataSettingsAndProcesses.SColorString
<StackLayout>
    
    <StackItem>
        <GridGameBoard SpaceList="DataContext!.GetBoardList"
                       TargetSpaceHeight="95"
                       TargetSpaceWidth="95"
                       S="SpaceInfoCP">
            <ItemTemplate Context="Space">
                <StateContentView DataContext="Space">
                    <BasePieceGraphics LongestSize="95" CommandObject="ColumnCommand" CommandParameter="Space">
                        <CheckerPiece BlankColor="@cc1.Aqua" HasImage="@Space.HasImage" MainColor="@Space.Color" PieceCategory="EnumCheckerPieceCategory.OnlyPiece" />
                    </BasePieceGraphics>
                </StateContentView>

            </ItemTemplate>
            <Canvas>
                <AnimationVectorCanvas S="SpaceInfoCP" Context="Space">
                    <AnimateCheckers Color="@Space.Color" LongestSize="95" PieceCategory="EnumCheckerPieceCategory.OnlyPiece" />
                </AnimationVectorCanvas>
            </Canvas>
        </GridGameBoard>
    </StackItem>
    <StackItem>
        <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
    </StackItem>
</StackLayout>