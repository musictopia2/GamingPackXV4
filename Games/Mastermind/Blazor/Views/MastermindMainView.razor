@inherits CascadingGameView<MastermindMainViewModel>
<StackLayout ItemSpacing="10px">
    <StackItem>
        <StateContentView DataContext="DataContext!.MainBoard">
            <GameBoardView DataContext="DataContext!.MainBoard" />
        </StateContentView>
        
    </StackItem>
    <StackItem Style="background-color: brown;">
        <EnumPickerBlazor E="EnumColorPossibilities" Context="Piece" Rows="10" SizeCategory="EnumSize.Small" ListPicker="DataContext!.Color1">
            <CirclePiece MainColor="@Piece.ColorFromEnum" />
        </EnumPickerBlazor>
    </StackItem>
    <StackItem>
        <div>
            <GameActionButton CommandObject="DataContext!.AcceptCommand" Display="Accept" />
        </div>
        <div>
            <GameActionButton CommandObject="DataContext.GiveUpCommand" Display="Give Up" />
        </div>
        <GameLabel StartsOnNewLine="true">
            Level Chosen: @DataContext!.LevelChosen
        </GameLabel>
    </StackItem>
</StackLayout>