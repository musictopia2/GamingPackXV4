@if (GameData == null || TestData == null || BasicData == null)
{
    if (GameData == null)
    {
        <div>No Game Data</div>
    }
    if (TestData == null)
    {
        <div>No Test Data</div>
    }
    if (BasicData == null)
    {
        <div>No Basic Data</div>
    }
    return;
}
<CascadingValue Value="@TargetHeight">
    <MainScreen>
        <CascadingValue Value="GetContainer">
            <FluxxMainView />
        </CascadingValue>
    </MainScreen>

    <PromptView VM="PromptViewModel">
        <FluxxPromptView />
    </PromptView>
    <MultiplayerOpeningView P="FluxxPlayerItem" />
</CascadingValue>