@inherits CascadingGameView<Phase10MainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout>
    <StackItem>
        <HandBlazor Hand="_vmData.PlayerHand1" />
    </StackItem>
    <StackItem>
        <DrawPileBlazor DeckPile="_vmData.Deck1" />
    </StackItem>
    <StackItem>
        <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
    </StackItem>
    <StackItem>
        <ScoreBoardBlazor P="Phase10PlayerItem"
                          Columns="_scores"
                          Players="_gameContainer.SaveRoot.PlayerList" />
    </StackItem>
</StackLayout>
<StackLayout>
    <StackItem>
        <GameActionButton CommandObject="CompleteCommand" Display="Complete Phase" />
    </StackItem>
    <StackItem>
        <LabelGridComponent DataContext="_vmData" Labels="_labels" />
    </StackItem>
</StackLayout>
<StackLayout>
    <StackItem>
        <TempSetsBlazor HeightPercent="69"
                        TempPiles="_vmData.TempSets" />
    </StackItem>

    <StackItem>
        @if (NeedsToChooseSkip == false)
        {
            <MainRummySetsBlazor HeightPercent="69"
                             DataContext="_vmData.MainSets" />
        }
        else
        {
            <ListChooserBlazor ListPicker="@_vmData.PlayerPicker" />
            <div style="margin-top: 20px;">
                <GameActionButton CommandObject="SKipCommand" Display="Submit Chosen Player To Skip" />
            </div>
            
        }
    </StackItem>
</StackLayout>