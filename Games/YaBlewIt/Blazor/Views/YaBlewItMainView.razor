@inherits CascadingGameView<YaBlewItMainViewModel>
@if (_vmData == null || DataContext == null || _gameContainer == null)
{
    return;
}
<StackLayout Orientation="EnumOrientation.Horizontal" ItemSpacing="5px">
    <StackItem>
        <SingleMiscPileBlazor SinglePile="_vmData.Pile1" />
    </StackItem>
    <StackItem>
        <DrawPileBlazor DeckPile="_vmData.Deck1" />
    </StackItem>
    <StackItem>
        <HandBlazor Hand="_vmData.Claims" TargetContainerSize="80vw" />
    </StackItem>
</StackLayout>
<div>
    <HandBlazor Hand="_vmData.PlayerHand1" TargetContainerSize="95vw" />
</div>
<div>
    <GameActionButton CommandObject="PlayCommand"
                         Display="Play Card" />
    <GameActionButton CommandObject="EndCommand"
                         Display="End Turn" />
    <GameActionButton CommandObject="PassCommand"
                         Display="Pass" />
    <GameActionButton CommandObject="RollCommand"
                         Display="Roll Dice" />
    <GameActionButton CommandObject="TakeClaimCommand"
                         Display="Take Claim" />
    <GameActionButton CommandObject="GambleCommand"
                         Display="Gamble" />
    <GameActionButton CustomCallBack = "OpenPopup"
                         Display="Open Score Guide" />
    
</div>
<div style="height: @Pixels;">
    <DiceListConrolBlazor D="EightSidedDice" Cup="@DataContext.VMData.Cup"  PercentHeight="@_height" />
</div>
<div>
    <LabelGridComponent DataContext="_vmData" Labels="_labels" />
</div>
<div>
    <ScoreBoardBlazor P="YaBlewItPlayerItem"
                      Columns="_scores"
                      Players="_gameContainer.SaveRoot.PlayerList" />
</div>
<PopupFullScreen @bind-Visible="_showPopup">
    <ScorePopupComponent Close="ClosePopup" />
</PopupFullScreen>
<StateContentView DataContext="DataContext.VMData">
    <PopupFullScreen Visible="@DataContext.ShowSafeScreen">
        <SafeScreen />
    </PopupFullScreen>
</StateContentView>