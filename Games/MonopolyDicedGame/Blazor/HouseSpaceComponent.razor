<SpaceBlazor MarginLeft="25" MarginTop="-4" Column="6" Row="7">
    <ColorSpaceComponent HeightPercent="HeightPercent">
        @if (HasHotel)
        {
            <MiscDiceBlazor HeightPercent="HeightPercent"
                            Category="EnumMiscType.Hotel" />
        }
        else if (HousesOwned > 0)
        {
            <MiscDiceBlazor NumberOfHouses="@HousesOwned"
                            HeightPercent="HeightPercent"
                            Category="EnumMiscType.RegularHouse" />
        }
    </ColorSpaceComponent>
</SpaceBlazor>