@inherits CascadingGameView<MonopolyDicedGameMainViewModel>
<StackLayout>
    <StackItem>
        <GameBoardBlazor SaveInfo="_container!.SaveRoot"
                         TargetHeight="75vh"
                         HouseDice="_house"
                         MiscList="DataContext!.VMData.OtherActions"
                         UtilityClicked="UtilityV2Async"
                         TrainClicked="TrainV2Async"
                         PropertyClicked="PropertyV2Async"
                         IsEnabled = "true"
                         ImageHeight="9vh" />
        <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
    </StackItem>
    <StackItem>
        <GameButtonComponent Display="Roll Dice" CommandObject="RollDiceCommand" />
        <GameButtonComponent Display="End Turn" CommandObject="EndTurnCommand" />
        <MonopolyListBlazor ImageHeight="9vh" />
        <ScoreBoardBlazor P="MonopolyDicedGamePlayerItem" Players="DataContext!.MainGame.PlayerList" Columns="_scores" />
    </StackItem>
</StackLayout>