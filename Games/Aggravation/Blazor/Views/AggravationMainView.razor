@inherits CascadingGameView<AggravationMainViewModel>
<StackLayout>
    <StackItem Length="45vw">
        <GridContainer Columns="auto auto">
            <GridItem>
                <GameActionButton CommandObject="RollCommand" Display="Roll Dice" />
            </GridItem>
            <GridItem Column="2">
                <div style="height: @Pixels">
                    <DiceListConrolBlazor D="SimpleDice" Cup="@DataContext!.GetCup" PercentHeight="_height"/>
                </div>
            </GridItem>
        </GridContainer>
        <LabelGridComponent SizeCategory="EnumSize.Small" DataContext="DataContext!.VMData" Labels="_labels" />
    </StackItem>
    <StackItem>
        <GameBoardBlazor TargetHeight="100"
                         GameContainer="_gameContainer"
                         GraphicsData="_graphicsData" />
    </StackItem>
</StackLayout>