@inherits CascadingGameView<SorryMainViewModel>
<StackLayout>
    <StackItem Length="40vw">
        <div>
            <GameActionButton Display="End Turn" CommandObject="EndCommand" />
        </div>
        <div>
            <LabelGridComponent DataContext="DataContext!.VMData" Labels="_labels" />
        </div>
        <div>
            <div>Cards Details:</div>
            <div>
                @DataContext!.VMData.CardDetails
            </div>
        </div>
        @if (TestData!.AdvancedTestOptions && DataContext!.DidDraw == false)
        {
            <div>
                <GameActionButton Display="Lock Draw Card" CommandObject="LockCardCommand" />
            </div>
        }
    </StackItem>
    <StackItem>
        <GameBoardBlazor GraphicsData="_graphics" TargetHeight="100" />
    </StackItem>
</StackLayout>